# PLANTILLA PUBLICA: este archivo SI se sube al repositorio.
# No pongas aqui valores reales. Copialo a backend/.env y completa ahi tus datos.
# Las variables sensibles (usuario, contrasena, secretos) deben quedar vacias:
# el CI falla si alguna trae un valor (pnpm verificar:secretos).

PORT=3000
# 127.0.0.1 = solo esta computadora (o un proxy en la misma maquina).
# Usa 0.0.0.0 solo si tu hosting lo pide y el puerto no es accesible sin pasar por su proxy.
DIRECCION_DE_ESCUCHA=127.0.0.1

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=beautysalon
DB_USER=
DB_PASSWORD=
# true cuando la base de datos esta en otro servidor (hosting): cifra la
# conexion y verifica el certificado. false en tu computadora.
DB_SSL=false

# Clave para firmar las sesiones de la duena (minimo 32 caracteres, secreta).
# Generar una con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRETO=
DURACION_SESION_HORAS=12

# Seguridad en produccion
# Cuantos proxies hay delante de la API (0 en tu computadora; normalmente 1 en un hosting).
PROXIES_DE_CONFIANZA=0
# true cuando la API se sirva por HTTPS: rechaza HTTP plano (menos /api/salud).
# Necesita PROXIES_DE_CONFIANZA de 1 o mas.
# Obligatorio en produccion (pnpm start o NODE_ENV=production): sin esto no arranca.
SOLO_HTTPS=false
