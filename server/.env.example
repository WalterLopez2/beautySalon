PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=beautysalon
DB_USER=
DB_PASSWORD=

# Clave para firmar las sesiones de la duena (minimo 32 caracteres, secreta).
# Generar una con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRETO=
DURACION_SESION_HORAS=12

# Seguridad en produccion
# Cuantos proxies hay delante de la API (0 en tu computadora; normalmente 1 en un hosting).
PROXIES_DE_CONFIANZA=0
# true cuando la API se sirva por HTTPS.
SOLO_HTTPS=false
